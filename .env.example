# Configure these values in Vercel Project Settings > Environment Variables.
ADMIN_USERNAME=choose-a-private-admin-username
ADMIN_PASSWORD=choose-a-long-random-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
KV_REST_API_URL=https://your-upstash-redis-endpoint.upstash.io
KV_REST_API_TOKEN=your-upstash-redis-token
